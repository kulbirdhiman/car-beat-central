# Clerk sign-in for /admin. Keys are at https://dashboard.clerk.com → API keys.
# In development you can leave them unset: Clerk runs in "keyless" mode with temporary keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Who may use /admin: comma-separated emails of Clerk accounts. Nobody gets in when unset.
ADMIN_EMAILS=you@example.com

# Supabase Postgres (Project Settings → Database → Connection string).
# DATABASE_URL: the "Transaction pooler" string (port 6543), used by the app.
# DIRECT_URL: the "Session pooler" string (port 5432), used by `npm run db:migrate`.
DATABASE_URL=
DIRECT_URL=

# Public site URL, used for absolute Open Graph image links (e.g. https://carbeat.com.au)
# SITE_URL=

# Supabase Storage, for image uploads in /admin. Create a public bucket (default name "images").
# The service role key stays on the server; never prefix it with NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=images

# PayPal Checkout. Create an app at https://developer.paypal.com/dashboard/applications (Sandbox for testing, Live for real payments).
# The client id is public; the secret stays on the server. PAYPAL_ENV=live charges real money; anything else uses the sandbox.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
