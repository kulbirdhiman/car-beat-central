# Password for /admin (username: admin). Admin is disabled when unset.
ADMIN_PASSWORD=1234

# Optional: where the SQLite database file lives (defaults to ./data/carbeat.db)
# DATABASE_PATH=

# Public site URL, used for absolute Open Graph image links (e.g. https://carbeat.com.au)
# SITE_URL=

# Supabase Storage, for image uploads in /admin. Create a public bucket (default name "images").
# The service role key stays on the server; never prefix it with NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=images
